
<?import java.net.URL?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<StackPane styleClass="root" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.the_knife.RecensioneRistoranteSearchController">
    <BorderPane styleClass="root">
        <padding>
            <Insets top="20" right="15" bottom="20" left="15"/>
        </padding>
        <stylesheets>
            <URL value="@style.css"/>
        </stylesheets>
        <top>
            <HBox alignment="TOP_RIGHT" spacing="10">
                <padding>
                    <Insets top="20" right="15" bottom="20" left="15"/>
                </padding>
                <Button text="INDIETRO" onAction="#goBack" styleClass="menu-button"/>
                <Button text="CHIUDI" onAction="#closeProgram" styleClass="menu-button"/>
            </HBox>
        </top>
        <center>
            <VBox spacing="10">
                <Label fx:id="welcomeLabel" styleClass="welcome-title"/>
                <ListView fx:id="listaRecLabel" prefHeight="600" prefWidth="300" />
            </VBox>
        </center>
    </BorderPane>
</StackPane>

