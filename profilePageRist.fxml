<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.Integer?>
<?import javafx.scene.image.ImageView?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.the_knife.Ristoratore.ProfilePageRistController" >
    <BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="root">

        <top>
            <HBox alignment="TOP_RIGHT" spacing="10">
                <padding>
                    <Insets top="20" right="15" bottom="20" left="15"/>
                </padding>
                <Button onAction="#onRistorantiClick" text="MIEI RISTORANTI" styleClass="menu-button"/>
                <Button text="INDIETRO" onAction="#goBack" styleClass="menu-button"/>
                <Button text="ESCI" onAction="#handleLogOut" styleClass="menu-button"/>
                <Button text="CHIUDI" onAction="#closeProgram" styleClass="menu-button"/>
            </HBox>
        </top>

        <center>
            <VBox spacing="10">
                <Label fx:id="welcomeLabel" styleClass="welcome-title"/>
                <GridPane fx:id="grid" prefHeight="600" prefWidth="300" maxWidth="800" />
            </VBox>
        </center>
        <stylesheets>
            <URL value="@../style.css"/>
        </stylesheets>
    </BorderPane>
</StackPane>