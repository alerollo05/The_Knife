<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.Integer?>
<?import javafx.scene.image.ImageView?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.the_knife.ProfilePageController" >
    <BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="root">
        <padding>
            <Insets top="20" right="15" bottom="20" left="15"/>
        </padding>
        <top>
            <HBox alignment="TOP_RIGHT" spacing="10">
                <Button text="ENTRA NELLA COMMUNITY" onAction="#goToLogin" styleClass="menu-button"/>
                <Button text="CHIUDI" onAction="#closeProgram" styleClass="menu-button"/>
            </HBox>
        </top>

        <center>
            <VBox alignment="TOP_CENTER" spacing="10" styleClass="form-box">

                <Label text="THE KNIFE" styleClass="welcome-subtitle"/>
                <Label text="Il  tuo profilo" styleClass="welcome-title"/>
                <Label text="Cerca i migliori ristoranti nei tuoi dintorni" styleClass="textSearch" />
            </VBox>
        </center>

        <stylesheets>
            <URL value="@style.css"/>
        </stylesheets>
    </BorderPane>
</StackPane>