<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.Integer?>
<?import javafx.scene.image.ImageView?>
<StackPane  styleClass="root" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.the_knife.Ristoratore.DettaglioRistController" >
    <BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="root">
        <padding>
            <Insets top="20" right="15" bottom="20" left="15"/>
        </padding>
        <top>
            <HBox alignment="TOP_RIGHT" spacing="10">
                <Button text="INDIETRO" onAction="#goBack" styleClass="menu-button"/>
                <Button text="ESCI" onAction="#handleLogOut" styleClass="menu-button"/>
                <Button text="CHIUDI" onAction="#closeProgram" styleClass="menu-button"/>
            </HBox>
        </top>

        <center>
            <Label fx:id="welcomeLabel" styleClass="welcome-title"/>
        </center>

        <stylesheets>
            <URL value="@../style.css"/>
        </stylesheets>
    </BorderPane>
</StackPane>
